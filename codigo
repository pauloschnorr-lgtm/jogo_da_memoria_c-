void modoJogo(int &modo){
    cout << "Escreva 1 para modo de jogo normal(24 cartas) ou 2 para modo de jogo rapido(18 cartas):";
    cin >> modo;
}

void inicialiazarTabuleiroNormal(int tabuleiroNormal[TamLinhaNormal][TamColunaNormal])
{
    for (int i = 0; i < TamLinhaNormal; i++)
    {
        for (int j = 0; j < TamColunaNormal; j++)
        {
            tabuleiroNormal[i][j] = 0;
        }
    }
}

void inicialiazarTabuleiroVisivelNormal(int visivelNormal[TamLinhaNormal][TamColunaNormal])
{
    for (int i = 0; i < TamLinhaNormal; i++)
    {
        for (int j = 0; j < TamColunaNormal; j++)
        {
            visivelNormal[i][j] = 0;
        }
    }
}

void exibirTabuleiroNormal(int tabuleiroNormal[TamLinhaNormal][TamColunaNormal])
{
    int colunaNormal = 1;

    cout << "TABULEIRO DO JOGO DA MEMORIA:" << endl;
    cout << "   1  2  3  4  5  6" << endl;

    for (int i = 0; i < TamLinhaNormal; i++)
    {
        cout << colunaNormal << " ";

        colunaNormal++;

        for (int j = 0; j < TamColunaNormal; j++)
        {
            cout << "[" << tabuleiroNormal[i][j] << "]";
        }

        cout << endl;
    }
}

void embaralharCartasNormal(int cartasNormal[], int qtdCartasNormal)
{
    for (int i = 0; i < qtdCartasNormal; i++)
    {
        int posicaoNormal = rand() % qtdCartasNormal;

        int temporariaNormal = cartasNormal[i];
        cartasNormal[i] = cartasNormal[posicaoNormal];
        cartasNormal[posicaoNormal] = temporariaNormal;
    }
}

void preencherTabuleiroNormal(int tabuleiroNormal[TamLinhaNormal][TamColunaNormal], int cartasNormal[])
{
    int cartinhasNormal = 0;
    for (int i = 0; i < TamLinhaNormal; i++)
    {
        for (int j = 0; j < TamColunaNormal; j++)
        {
            tabuleiroNormal[i][j] = cartasNormal[cartinhasNormal];
            cartinhasNormal++;
        }
    }
}

void jogarNormal(int tabuleiroNormal[TamLinhaNormal][TamColunaNormal], int visivelNormal[TamLinhaNormal][TamColunaNormal], string jogador1, string jogador2, int qtd){
    int paresNormal = 0;
    int linha1Normal = 0;
    int coluna1Normal = 0;
    int linha2Normal = 0;
    int coluna2Normal = 0;
    int pontos1Normal = 0;
    int pontos2Normal = 0;

    while (paresNormal < 12)
    {
        cout << jogador1 << " informe a linha da primeira carta: " << endl;
        cin >> linha1Normal;
        cout << jogador1 << " informe a coluna da primeira carta: " << endl;
        cin >> coluna1Normal;
        cout << jogador1 << " informe a linha da segunda carta: " << endl;
        cin >> linha2Normal;
        cout << jogador1 << " informe a coluna da segunda carta: " << endl;
        cin >> coluna2Normal;

        linha1Normal--;
        coluna1Normal--;
        linha2Normal--;
        coluna2Normal--;

        if (linha1Normal < 0 || linha1Normal >= TamLinhaNormal || coluna1Normal < 0 || coluna1Normal >= TamColunaNormal || linha2Normal < 0 || linha2Normal >= TamLinhaNormal || coluna2Normal < 0 || coluna2Normal >= TamColunaNormal){
            cout << "Posicao invalida!" << endl;
        }
        else
        {
            cout << "[" << tabuleiroNormal[linha1Normal][coluna1Normal] << "] "
                 << "[" << tabuleiroNormal[linha2Normal][coluna2Normal] << "]";

            if (tabuleiroNormal[linha1Normal][coluna1Normal] == tabuleiroNormal[linha2Normal][coluna2Normal])
            {
                cout << " -> sao iguais!" << endl;
                pontos1Normal++;
                visivelNormal[linha1Normal][coluna1Normal] = tabuleiroNormal[linha1Normal][coluna1Normal];
                visivelNormal[linha2Normal][coluna2Normal] = tabuleiroNormal[linha2Normal][coluna2Normal];
                paresNormal++;
            }
            else
            {
                cout << " -> nao sao iguais! : (" << endl;
            }
        }
        exibirTabuleiroNormal(visivelNormal);
        if (paresNormal >= 12)
        {
            break;
        }
        if(qtd == 2){
            cout << endl;
            cout << jogador2 << " informe a linha da primeira carta: " << endl;
            cin >> linha1Normal;
            cout << jogador2 << " informe a coluna da primeira carta: " << endl;
            cin >> coluna1Normal;
            cout << jogador2 << " informe a linha da segunda carta: " << endl;
            cin >> linha2Normal;
            cout << jogador2 << " informe a coluna da segunda carta: " << endl;
            cin >> coluna2Normal;

            linha1Normal--;
            coluna1Normal--;
            linha2Normal--;
            coluna2Normal--;

            if (linha1Normal < 0 || linha1Normal >= TamLinhaNormal || coluna1Normal < 0 || coluna1Normal >= TamColunaNormal || linha2Normal < 0 || linha2Normal >= TamLinhaNormal || coluna2Normal < 0 || coluna2Normal >= TamColunaNormal)
            {
              cout << "Posicao invalida!" << endl;
            }
             else
            {
                cout << "[" << tabuleiroNormal[linha1Normal][coluna1Normal] << "] "
                    << "[" << tabuleiroNormal[linha2Normal][coluna2Normal] << "]";
               if (tabuleiroNormal[linha1Normal][coluna1Normal] == tabuleiroNormal[linha2Normal][coluna2Normal])
                {
                   cout << " -> sao iguais!" << endl;
                   pontos2Normal++;
                   visivelNormal[linha1Normal][coluna1Normal] = tabuleiroNormal[linha1Normal][coluna1Normal];
                   visivelNormal[linha2Normal][coluna2Normal] = tabuleiroNormal[linha2Normal][coluna2Normal];
                   paresNormal++;
                }
               else
               {
                   cout << " -> nao sao iguais! : (" << endl;
               }
           }
        }
        exibirTabuleiroNormal(visivelNormal);
        cout << endl;
        cout << "Pontuacao atual:" << endl;
        cout << jogador1 << ": " << pontos1Normal << endl;
        if(qtd ==2){
           cout << jogador2 << ": " << pontos2Normal << endl;
        }
    }
    cout << endl;
    cout << "FIM DO JOGO!" << endl;
    cout << jogador1 << ": " << pontos1Normal << " pontos" << endl;
    if(qtd ==2){
        cout << jogador2 << ": " << pontos2Normal << " pontos" << endl;
    }
    if (pontos1Normal > pontos2Normal)
    {
        cout << "Vencedor: " << jogador1 << "!" << endl;
    }
    else
    {
        cout << "Vencedor: " << jogador2 << "!" << endl;
    }
}

void inicialiazarTabuleiroRapida(int tabuleiroRapida[TamLinhaRapida][TamColunaRapida])
{
    for (int i = 0; i < TamLinhaRapida; i++)
    {
        for (int j = 0; j < TamColunaRapida; j++)
