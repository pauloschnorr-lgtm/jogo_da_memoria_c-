void embaralharCartasRapida(int cartasRapida[], int qtdCartasRapida)
{
    for (int i = 0; i < qtdCartasRapida; i++)
    {
        int posicaoRapida = rand() % qtdCartasRapida;

        int temporariaRapida = cartasRapida[i];
        cartasRapida[i] = cartasRapida[posicaoRapida];
        cartasRapida[posicaoRapida] = temporariaRapida;
    }
}

void preencherTabuleiroRapida(int tabuleiroRapida[TamLinhaRapida][TamColunaRapida], int cartasRapida[])
{
    int cartinhas = 0;
    for (int i = 0; i < TamLinhaRapida; i++)
    {
        for (int j = 0; j < TamColunaRapida; j++)
        {
            tabuleiroRapida[i][j] = cartasRapida[cartinhas];
            cartinhas++;
        }
    }
}

